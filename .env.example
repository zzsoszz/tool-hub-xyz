# 部署与翻译共用同一个 Cloudflare 账户令牌（GitHub Actions Secrets 同名）
# 本机真实值见被 gitignore 的 credentials.local.md，不要提交
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id

# 中文翻译：默认走 Cloudflare Workers AI；也可改用 OpenAI 兼容接口
TRANSLATE=1
TRANSLATE_MODEL=@cf/meta/llama-3.1-8b-instruct
TRANSLATE_BATCH_SIZE=8
# TRANSLATE_API_BASE=https://api.openai.com/v1
# TRANSLATE_API_KEY=
# TRANSLATE_MODEL=gpt-4o-mini

# 论坛（评论/点赞）：Worker Secret，用于 IP 哈希与删除评论
COMMENT_SALT=replace-with-random-secret
MODERATION_TOKEN=replace-with-random-secret

# 运行时
TIMEZONE=Asia/Shanghai
SITE_URL=https://tool-hub.xyz
